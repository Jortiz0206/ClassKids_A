# Copia este archivo a ".env" (en la carpeta backend/) para personalizar la
# configuración local. Ninguna de estas variables es obligatoria para desarrollo:
# si no se define, el backend usa el valor por defecto indicado entre paréntesis.

# Cadena de conexión a PostgreSQL.
# (default: postgresql+psycopg://postgres:postgrespassword@localhost:5432/classkids)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/classkids

# Orígenes permitidos por CORS, separados por comas. Debe incluir el origen real
# desde donde corre el frontend (Vite corre en el puerto 8080 por defecto, ver
# frontend/vite.config.ts).
# (default: http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Secreto usado para firmar los JWT de sesión. OBLIGATORIO si ENVIRONMENT=production
# (el backend no arranca sin él en ese caso). En desarrollo, si se omite, se genera
# uno aleatorio por proceso: las sesiones se invalidan cada vez que reinicias el backend.
JWT_SECRET=

# "development" (default) o "production". En production, JWT_SECRET es obligatorio.
ENVIRONMENT=development

# URL base del frontend, usada para construir los enlaces de invitación y de
# restablecimiento de contraseña que se envían por correo.
# (default: http://127.0.0.1:8080)
FRONTEND_URL=http://127.0.0.1:8080

# Configuración SMTP para el envío real de correos (invitaciones y recuperación
# de contraseña). Si SMTP_HOST no está definido, el backend NO envía ningún correo
# (los flujos de invitación/reseteo seguirán funcionando vía la API, pero el enlace
# no llegará al destinatario por ningún medio).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@classkids.local
