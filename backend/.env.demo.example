# Configuración de ejemplo del entorno de DEMOSTRACIÓN (sin secretos reales).
# `python demo/generar_demo.py preparar` copia este archivo a backend/.env.demo (excluido de Git)
# y reemplaza JWT_SECRET por una clave aleatoria.

CLASSKIDS_ENTORNO=demo
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@127.0.0.1:5434/classkids_demo
JWT_SECRET=reemplazar-por-una-clave-aleatoria
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
FRONTEND_URL=http://localhost:8082

# Opcional: contraseñas de las cuentas de demostración. Si no se definen, el generador crea
# contraseñas aleatorias y las anota en backend/CREDENCIALES_DEMO.md (excluido de Git).
# DEMO_ADMIN_PASSWORD=
# DEMO_DOCENTE_PASSWORD=
